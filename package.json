{
  "name": "card-game-monorepo",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev:engine": "pnpm --filter combat-engine start:dev",
    "dev:gasha": "pnpm --filter gasha dev",
    "build:engine": "pnpm --filter combat-engine build",
    "build:gasha": "pnpm --filter gasha build",
    "build:all": "pnpm -r build",
    "test:engine": "pnpm --filter combat-engine test",
    "test:e2e:engine": "pnpm --filter combat-engine test:e2e",
    "test:all": "pnpm -r test",
    "lint:engine": "pnpm --filter combat-engine lint",
    "lint:all": "pnpm -r lint"
  }
}
